# ---------------------------------------------------------------------------
# Neulens AI service (FastAPI) — server-side only.
# This file is never bundled into the browser application.
# ---------------------------------------------------------------------------

ENVIRONMENT=development
LOG_LEVEL=info

# Supabase project. The service-role key is read here and MUST NOT be exposed
# to the client; the browser only ever holds the signed-in user's access token.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# JWT verification. Provide exactly one of the following:
#   * SUPABASE_JWKS_URL  — https://<ref>.supabase.co/auth/v1/.well-known/jwks.json (RS256)
#   * SUPABASE_JWT_SECRET — legacy shared secret (HS256), development only
SUPABASE_JWKS_URL=
SUPABASE_JWT_SECRET=
SUPABASE_AUDIENCE=authenticated

# Allowed browser origins for CORS (comma separated).
ALLOWED_ORIGINS=http://localhost:5173

# Shared secret for server-to-server audio analysis. The Express API forwards
# uploaded clips here for portal sessions it authenticates itself. Use a long
# random value, set it in both services, and never expose it to a browser.
INTERNAL_API_KEY=

# Local open-weights explanation model served by Ollama (llama/qwen/gemma/
# mistral). Keep this on localhost so assessment data does not leave the
# deployment; the service falls back to a deterministic template if Ollama is
# not running. Clinician review is always required.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=20

# Upstream model providers (voice/vision models). Keys stay here.
GNANI_API_BASE_URL=https://api.vachana.ai
GNANI_API_KEY=
GNANI_TIMEOUT_MS=15000

# Feature flags: keep heavy model pipelines off until their weights and
# validation data are available. The service returns computed signal features
# and marks model-backed outputs as unavailable instead of inventing them.
ENABLE_MODEL_INFERENCE=false

# Speech/non-speech detection: Silero VAD is used when installed, otherwise an
# energy segmenter runs and responses report "vad": "energy".
# Install it with: pip install silero-vad   (pulls torch)
# Compressed audio (browser WebM/Opus) is decoded with ffmpeg.
