{
  "name": "cognivision-ai",
  "version": "1.0.0",
  "description": "Neulens - Neurological & Cognitive Screening Hospital Platform",
  "private": true,
  "scripts": {
    "install:all": "npm --prefix server install && npm --prefix client install",
    "build:client": "npm --prefix client run build",
    "build:server": "npm --prefix server run build",
    "build": "npm run build:client && npm run build:server",
    "db:deploy": "npm --prefix server run prisma:deploy",
    "start": "node server/dist/app.js",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "test": "npm --prefix server test"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "neurology",
    "cognitive-assessment",
    "ai",
    "healthcare",
    "mediapipe",
    "gnani-ai"
  ],
  "author": "CogniVision Team",
  "license": "ISC",
  "dependencies": {
    "cognivision-ai-client": "file:client",
    "cognivision-ai-server": "file:server"
  }
}
